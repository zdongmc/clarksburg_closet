# Postgres connection string (Neon). Required.
POSTGRES_URL=

# Shared passcode that gates the volunteer queue and reports. Required.
# The request form itself is public and needs no passcode.
# Nothing records WHICH volunteer signed in - that was a deliberate choice;
# see CLAUDE.md, "Volunteer identity".
VOLUNTEER_PASSCODE=

# Secret used to sign the volunteer session cookie. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
